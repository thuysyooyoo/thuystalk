rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'thuystalk.official@gmail.com',
          'thuyn.bic@gmail.com'
        ];
    }

    function isValidConsultLead() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'timestamp', 'type', 'name', 'phone', 'email',
          'topic', 'message', 'consent_nd13', 'createdAt', 'source'
        ])
        && d.keys().hasAll(['name', 'email', 'type', 'consent_nd13'])
        && d.type is string && d.type != 'download' && d.type.size() > 0 && d.type.size() <= 80
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.email is string && d.email.size() > 2 && d.email.size() <= 160
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 40))
        && (!('topic' in d) || (d.topic is string && d.topic.size() <= 300))
        && (!('message' in d) || (d.message is string && d.message.size() <= 3000))
        && (!('id' in d) || (d.id is string && d.id.size() <= 80))
        && (!('timestamp' in d) || (d.timestamp is string && d.timestamp.size() <= 80))
        && (!('source' in d) || (d.source is string && d.source.size() <= 120))
        && d.consent_nd13 == true;
    }

    function isValidDownloadLead() {
      let d = request.resource.data;
      return isVerifiedUser()
        && d.keys().hasOnly([
          'type', 'uid', 'email', 'name', 'itemType',
          'itemId', 'itemTitle', 'fileName', 'createdAt'
        ])
        && d.keys().hasAll([
          'type', 'uid', 'email', 'itemType',
          'itemId', 'itemTitle', 'fileName'
        ])
        && d.type == 'download'
        && d.uid == request.auth.uid
        && d.email is string && request.auth.token.email is string
        && d.email.lower() == request.auth.token.email.lower()
        && d.email.size() <= 160
        && (!('name' in d) || (d.name is string && d.name.size() <= 120))
        && d.itemType is string && d.itemType.size() > 0 && d.itemType.size() <= 40
        && d.itemId is string && d.itemId.size() > 0 && d.itemId.size() <= 120
        && d.itemTitle is string && d.itemTitle.size() > 0 && d.itemTitle.size() <= 300
        && d.fileName is string && d.fileName.size() > 0 && d.fileName.size() <= 260;
    }

    // 1. Public-read Content & Settings (Admin-only writes)
    match /articles/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ai_kb/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media_images/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Document Links (Requires verified login to read, Admin-only write)
    match /doc_links/{docId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin();
    }

    // 3. Leads & Download History
    match /leads/{leadId} {
      allow read, update, delete: if isAdmin();
      allow create: if isValidConsultLead() || isValidDownloadLead();
    }

    // 4. Learners Profiles (Owner or Admin read; verified owner or Admin write)
    match /learners/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isAdmin() || (isVerifiedUser() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // 5. Default Deny for any other collection (including legacy elearning_courses / settings)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
