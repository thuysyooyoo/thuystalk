# Cau hinh Gmail SMTP cho server_thuystalk.py
# U1: Chu du an tu tao App Password moi va dien vao file .env (KHONG commit file .env)
THUYSTALK_SMTP_SENDER=thuystalk.official@gmail.com
THUYSTALK_SMTP_APP_PASSWORD=
THUYSTALK_SMTP_HOST=smtp.gmail.com
THUYSTALK_SMTP_PORT=465

# Gioi han ma xac nhan thiet bi moi & khoa HMAC (R7-01)
THUYSTALK_DEVICE_CODES_PER_USER_HOURLY=3
THUYSTALK_DEVICE_CODES_GLOBAL_HOURLY=30
THUYSTALK_DEVICE_CODE_SECRET=

# Gioi han luot tra cuu AI Notebook & tran toan server (R4-01 + G4-03)
THUYSTALK_AI_PER_USER_HOURLY=10
THUYSTALK_AI_PER_GUEST_IP_HOURLY=20
THUYSTALK_AI_GLOBAL_HOURLY_LIMIT=20
THUYSTALK_AI_GLOBAL_DAILY_LIMIT=120
